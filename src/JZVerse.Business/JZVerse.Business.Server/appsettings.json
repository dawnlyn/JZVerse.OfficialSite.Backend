{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "JZVerse": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "business-server",
    "ServiceVersion": "1.0.0",
    "Console": {
      "Enabled": true,
      "EnableColors": true,
      "MaxPayloadLength": 2048,
      "SlowCallThresholdMs": 500
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "Format": "Text",
      "MaxFileSizeMB": 50,
      "RetainDays": 30,
      "MaxTotalSizeMB": 1024
    },
    "OpenTelemetry": {
      "Enabled": true,
      "Endpoint": "http://localhost:17011",
      "Protocol": "Grpc"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=jzverse;Username=postgres;Password=postgres"
  },
  "ServiceDiscovery": {
    "Client": {
      "ServerUrls": ["http://localhost:5100"],
      "Service": {
        "ServiceName": "business-server",
        "Host": "localhost",
        "Port": 5106,
        "Scheme": "http",
        "Version": "1.0.0",
        "Tags": ["business", "api"],
        "Weight": 100,
        "AutoRegister": true,
        "AutoDeregister": true
      },
      "Heartbeat": {
        "Enabled": true,
        "IntervalSeconds": 10
      },
      "HealthCheck": {
        "Enabled": true,
        "Endpoint": "/health",
        "IntervalSeconds": 10
      }
    }
  },
  "ConfigCenter": {
    "Client": {
      "ServerUrls": ["http://localhost:5101"],
      "ApplicationId": "business-server",
      "EnvironmentId": "development",
      "Namespaces": [
        "business.common",
        "business.blog",
        "business.academy",
        "business.project",
        "business.dashboard"
      ],
      "NotificationMode": "Polling",
      "PollingIntervalSeconds": 30,
      "EnableLocalCache": true,
      "LocalCachePath": "./config-cache"
    }
  },
  "ServiceCommunication": {
    "Http": {
      "TimeoutSeconds": 30
    },
    "Resilience": {
      "Retry": {
        "MaxRetries": 3,
        "DelayMilliseconds": 100,
        "MaxDelayMilliseconds": 2000,
        "UseExponentialBackoff": true
      },
      "CircuitBreaker": {
        "FailureThreshold": 5,
        "SamplingDurationSeconds": 30,
        "BreakDurationSeconds": 30
      }
    }
  },
  "MessageQueue": {
    "Client": {
      "Host": "localhost",
      "Port": 9527,
      "ClientId": "business-server",
      "ConsumerGroup": "business-group",
      "AutoReconnect": true,
      "ReconnectIntervalSeconds": 5
    }
  },
  "Saga": {
    "Storage": "Memory",
    "CommunicationMode": "Http",
    "EnableCoordinator": false,
    "TimeoutSeconds": 300
  },
  "Telemetry": {
    "Enabled": true,
    "ServiceName": "business-server",
    "ServiceVersion": "1.0.0",
    "Logging": {
      "Enabled": true,
      "MinimumLevel": "Information",
      "MaxInMemoryLogs": 10000
    },
    "Tracing": {
      "Enabled": true,
      "SamplingRatio": 1.0,
      "RecordHttpRequests": true
    },
    "Metrics": {
      "Enabled": true,
      "CollectionIntervalSeconds": 10
    }
  },
  "Authentication": {
    "Jwt": {
      "SecretKey": "default-secret-key-for-development-only-change-in-production",
      "Issuer": "jzverse",
      "Audience": "jzverse-api",
      "ExpirationMinutes": 120,
      "RefreshTokenExpirationDays": 7
    }
  },
  "Encryption": {
    "Sm2": {
      "Enabled": false
    }
  },
  "Management": {
    "RestartEnabled": true,
    "RestartDelaySeconds": 5,
    "CriticalConfigKeys": [
      "Authentication:Jwt:SecretKey",
      "Encryption:Sm2:PrivateKey",
      "Encryption:Sm2:PublicKey",
      "Kestrel:Endpoints"
    ]
  }
}
