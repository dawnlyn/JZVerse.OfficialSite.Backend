{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JZVerse.MicroHuaxia": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "DashboardServer",
    "ServiceVersion": "1.0.0",
    "Console": {
      "Enabled": true,
      "EnableColors": true,
      "MaxPayloadLength": 2048,
      "SlowCallThresholdMs": 500
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "Format": "Text",
      "MaxFileSizeMB": 50,
      "RetainDays": 30,
      "MaxTotalSizeMB": 1024
    },
    "OpenTelemetry": {
      "Enabled": true,
      "Endpoint": "http://localhost:17011",
      "Protocol": "Grpc"
    }
  },
  "Dashboard": {
    "Title": "MicroHuaxia 管理控制台",
    "EnableRealTimeMonitoring": true,
    "RefreshIntervalSeconds": 5,
    "ServiceEndpoints": {
      "ServiceDiscovery": "http://localhost:5100",
      "ConfigCenter": "http://localhost:5101",
      "Gateway": "http://localhost:5102",
      "MessageQueue": "http://localhost:5103",
      "Saga": "http://localhost:5104"
    },
    "Theme": {
      "PrimaryColor": "#1890ff",
      "Mode": "light"
    }
  },
  "ServiceDiscovery": {
    "Client": {
      "ServerUrls": [ "http://localhost:5100" ],
      "Service": {
        "ServiceName": "dashboard-server",
        "Host": "localhost",
        "Port": 5105,
        "Scheme": "http",
        "Version": "1.0.0",
        "Tags": [ "dashboard" ],
        "Weight": 100,
        "AutoRegister": true,
        "AutoDeregister": true
      },
      "Heartbeat": {
        "Enabled": true,
        "IntervalSeconds": 10
      },
      "HealthCheck": {
        "Enabled": true,
        "Endpoint": "/health",
        "IntervalSeconds": 10
      }
    }
  },
  "ConfigCenter": {
    "Client": {
      "ServerUrls": [ "http://localhost:5101" ],
      "ApplicationId": "dashboard-server",
      "EnvironmentId": "development",
      "Namespaces": [ "dashboard.server" ],
      "NotificationMode": "Polling",
      "PollingIntervalSeconds": 30,
      "EnableLocalCache": true,
      "LocalCachePath": "./config-cache"
    }
  }
}
