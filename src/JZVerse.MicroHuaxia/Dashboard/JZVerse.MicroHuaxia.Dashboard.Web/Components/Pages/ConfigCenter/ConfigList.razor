@page "/configs"
@inject IConfigCenterApiClient ConfigCenterClient
@inject IMessageService MessageService

<PageTitle>配置管理</PageTitle>

<div>
    <PageHeader Title="配置管理" SubTitle="管理应用配置">
        <PageHeaderExtra>
            <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Reload" Loading="@_loading" OnClick="@LoadDataAsync">
                刷新
            </Button>
        </PageHeaderExtra>
    </PageHeader>

    <Row Gutter="16">
        @* 命名空间列表 *@
        <Col Span="8">
            <Card Title="命名空间" Size="small">
                <Table TItem="ConfigNamespace"
                       DataSource="@_namespaces"
                       Loading="@_loading"
                       Size="TableSize.Small"
                       OnRowClick="OnNamespaceClick"
                       RowClassName="@(r => r.Data.Id == _selectedNamespaceId ? "ant-table-row-selected" : "")">
                    <PropertyColumn Property="c => c.Name" Title="名称" />
                    <PropertyColumn Property="c => c.ItemCount" Title="配置项数" Width="80" />
                </Table>
            </Card>
        </Col>

        @* 配置项列表 *@
        <Col Span="16">
            <Card Title="@($"配置项 - {_selectedNamespace?.Name ?? "请选择命名空间"}")" Size="small">
                @if (_selectedNamespace != null)
                {
                    <Table TItem="ConfigItem"
                           DataSource="@_configItems"
                           Loading="@_loadingItems"
                           Size="TableSize.Small">
                        <PropertyColumn Property="c => c.Key" Title="配置键" Ellipsis />
                        <PropertyColumn Property="c => c.Value" Title="配置值" Ellipsis>
                            <Tooltip Title="@context.Value">
                                <span>@(context.Value.Length > 50 ? context.Value[..50] + "..." : context.Value)</span>
                            </Tooltip>
                        </PropertyColumn>
                        <PropertyColumn Property="c => c.ValueType" Title="类型" Width="80">
                            <Tag>@context.ValueType</Tag>
                        </PropertyColumn>
                        <PropertyColumn Property="c => c.Version" Title="版本" Width="60" />
                        <ActionColumn Title="操作" Width="180">
                            <Space>
                                <SpaceItem>
                                    <Button Type="@ButtonType.Link" Icon="@IconType.Outline.Edit" OnClick="() => EditConfig(context)">
                                        编辑
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Button Type="@ButtonType.Link" Icon="@IconType.Outline.History" OnClick="() => ShowVersionHistory(context)">
                                        历史
                                    </Button>
                                </SpaceItem>
                                <SpaceItem>
                                    <Popconfirm Title="确定要删除此配置吗？" OkText="确定" CancelText="取消" OnConfirm="() => DeleteConfig(context.Id)">
                                        <Button Type="@ButtonType.Link" Danger Icon="@IconType.Outline.Delete">
                                            删除
                                        </Button>
                                    </Popconfirm>
                                </SpaceItem>
                            </Space>
                        </ActionColumn>
                    </Table>
                }
                else
                {
                    <Empty Description="@("请从左侧选择命名空间")" />
                }
            </Card>
        </Col>
    </Row>
</div>

@* 配置编辑模态框 *@
<Modal Title="@(_editingItem?.Id == null ? "新建配置" : "编辑配置")"
       Visible="@_editModalVisible"
       OnOk="@SaveConfig"
       OnCancel="@(() => _editModalVisible = false)"
       ConfirmLoading="@_saving"
       Width="600">
    @if (_editingItem != null)
    {
        <Form Model="@_editingItem" LabelColSpan="6" WrapperColSpan="18">
            <FormItem Label="配置键">
                <Input @bind-Value="@_editingItem.Key" Placeholder="请输入配置键" />
            </FormItem>
            <FormItem Label="配置值">
                <TextArea @bind-Value="@_editingItem.Value" Rows="6" Placeholder="请输入配置值" />
            </FormItem>
            <FormItem Label="值类型">
                <Select @bind-Value="@_editingItem.ValueType" TItemValue="ConfigValueType" TItem="string">
                    <SelectOptions>
                        <SelectOption Value="@ConfigValueType.String" Label="String" />
                        <SelectOption Value="@ConfigValueType.Json" Label="JSON" />
                        <SelectOption Value="@ConfigValueType.Yaml" Label="YAML" />
                        <SelectOption Value="@ConfigValueType.Number" Label="Number" />
                        <SelectOption Value="@ConfigValueType.Boolean" Label="Boolean" />
                    </SelectOptions>
                </Select>
            </FormItem>
            <FormItem Label="描述">
                <TextArea @bind-Value="@_editingItem.Description" Rows="2" Placeholder="配置描述（可选）" />
            </FormItem>
        </Form>
    }
</Modal>

@* 版本历史抽屉 *@
<Drawer Title="@($"版本历史 - {_historyItemKey}")"
        Width="640"
        Visible="@_historyDrawerVisible"
        OnClose="@(() => _historyDrawerVisible = false)">
    <Table TItem="ConfigVersionInfo"
           DataSource="@_versionHistory"
           Loading="@_loadingHistory"
           Size="TableSize.Small">
        <PropertyColumn Property="v => v.Version" Title="版本" Width="70" />
        <PropertyColumn Property="v => v.ChangeType" Title="变更类型" Width="90">
            <Tag Color="@GetChangeTypeColor(context.ChangeType)">@GetChangeTypeText(context.ChangeType)</Tag>
        </PropertyColumn>
        <PropertyColumn Property="v => v.NewValue" Title="新值" Ellipsis>
            <Tooltip Title="@context.NewValue">
                <span>@(context.NewValue.Length > 40 ? context.NewValue[..40] + "..." : context.NewValue)</span>
            </Tooltip>
        </PropertyColumn>
        <PropertyColumn Property="v => v.CreatedAt" Title="变更时间" Width="160">
            @context.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
        </PropertyColumn>
        <ActionColumn Title="操作" Width="80">
            <Popconfirm Title="@($"确定要回滚到版本 {context.Version} 吗？")" OkText="确定" CancelText="取消"
                        OnConfirm="() => RollbackToVersion(context)">
                <Button Type="@ButtonType.Link" Icon="@IconType.Outline.Rollback" Size="small">
                    回滚
                </Button>
            </Popconfirm>
        </ActionColumn>
    </Table>
</Drawer>

@code {
    private List<ConfigNamespace> _namespaces = new();
    private List<ConfigItem> _configItems = new();
    private bool _loading = false;
    private bool _loadingItems = false;
    private bool _editModalVisible = false;
    private bool _saving = false;
    private string? _selectedNamespaceId;
    private ConfigNamespace? _selectedNamespace;
    private ConfigItem? _editingItem;

    // 版本历史
    private bool _historyDrawerVisible;
    private bool _loadingHistory;
    private string _historyItemKey = string.Empty;
    private string _historyItemId = string.Empty;
    private List<ConfigVersionInfo> _versionHistory = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _namespaces = await ConfigCenterClient.GetNamespacesAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnNamespaceClick(RowData<ConfigNamespace> row)
    {
        _selectedNamespaceId = row.Data.Id;
        _selectedNamespace = row.Data;
        await LoadConfigItemsAsync();
    }

    private async Task LoadConfigItemsAsync()
    {
        if (_selectedNamespaceId == null) return;

        _loadingItems = true;
        try
        {
            _configItems = await ConfigCenterClient.GetConfigItemsAsync(_selectedNamespaceId);
        }
        finally
        {
            _loadingItems = false;
        }
    }

    private void EditConfig(ConfigItem item)
    {
        _editingItem = new ConfigItem
        {
            Id = item.Id,
            Key = item.Key,
            Value = item.Value,
            NamespaceId = item.NamespaceId,
            EnvironmentId = item.EnvironmentId,
            ValueType = item.ValueType,
            Description = item.Description
        };
        _editModalVisible = true;
    }

    private async Task SaveConfig()
    {
        if (_editingItem == null) return;

        _saving = true;
        try
        {
            await ConfigCenterClient.UpsertConfigItemAsync(_editingItem);
            await MessageService.Success("配置已保存");
            _editModalVisible = false;
            await LoadConfigItemsAsync();
        }
        catch (Exception ex)
        {
            await MessageService.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteConfig(string itemId)
    {
        try
        {
            await ConfigCenterClient.DeleteConfigItemAsync(itemId);
            await MessageService.Success("配置已删除");
            await LoadConfigItemsAsync();
        }
        catch (Exception ex)
        {
            await MessageService.Error($"删除失败: {ex.Message}");
        }
    }

    private async Task ShowVersionHistory(ConfigItem item)
    {
        _historyItemId = item.Id;
        _historyItemKey = item.Key;
        _historyDrawerVisible = true;
        _loadingHistory = true;
        try
        {
            _versionHistory = await ConfigCenterClient.GetConfigVersionHistoryAsync(item.Id);
        }
        finally
        {
            _loadingHistory = false;
        }
    }

    private async Task RollbackToVersion(ConfigVersionInfo version)
    {
        try
        {
            await ConfigCenterClient.RollbackConfigVersionAsync(_historyItemId, version.Version, $"从 Dashboard 回滚到版本 {version.Version}");
            await MessageService.Success($"已回滚到版本 {version.Version}");
            _versionHistory = await ConfigCenterClient.GetConfigVersionHistoryAsync(_historyItemId);
            await LoadConfigItemsAsync();
        }
        catch (Exception ex)
        {
            await MessageService.Error($"回滚失败: {ex.Message}");
        }
    }

    private static string GetChangeTypeColor(string changeType) => changeType switch
    {
        "Created" => "green",
        "Updated" => "blue",
        "Deleted" => "red",
        "Rollback" => "orange",
        _ => "default"
    };

    private static string GetChangeTypeText(string changeType) => changeType switch
    {
        "Created" => "新建",
        "Updated" => "更新",
        "Deleted" => "删除",
        "Rollback" => "回滚",
        _ => changeType
    };
}
