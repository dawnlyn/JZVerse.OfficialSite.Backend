    // ===== 格式化方法 =====
    private static string FormatTrend(double value) =>
        value > 0 ? $"+{value:F1}%" : $"{value:F1}%";

    private static string GetTrendClass(double value) =>
        value > 0 ? "up" : value < 0 ? "down" : "neutral";

    private static string GetHealthClass(double rate) =>
        rate >= 95 ? "healthy" : rate >= 80 ? "warning" : "error";

    private static string GetHealthBarClass(double rate) =>
        rate >= 95 ? "excellent" : rate >= 80 ? "good" : rate >= 60 ? "warning" : "critical";

    private static string GetStatusClass(string status) =>
        status?.ToLower() switch
        {
            "healthy" => "healthy",
            "warning" => "warning",
            "critical" => "critical",
            _ => "healthy"
        };

    private static string GetStatusText(string status) =>
        status?.ToLower() switch
        {
            "healthy" => "运行良好",
            "warning" => "需要注意",
            "critical" => "严重告警",
            _ => "运行良好"
        };

    private double GetSagaSuccessRate()
    {
        var total = _overview.Saga.Completed + _overview.Saga.Failed;
        return total > 0 ? Math.Round((double)_overview.Saga.Completed / total * 100, 1) : 100;
    }

    private static string FormatNumber(double num) =>
        num switch
        {
            >= 100000000 => $"{num / 100000000D:F1}亿",
            >= 10000 => $"{num / 10000D:F1}万",
            >= 1000 => $"{num / 1000D:F1}K",
            _ => num.ToString("F0")
        };

    private static string FormatTime(DateTime time)
    {
        var diff = DateTime.Now - time;
        return diff.TotalMinutes < 1 ? "刚刚" :
               diff.TotalHours < 1 ? $"{diff.Minutes}分钟前" :
               diff.TotalDays < 1 ? $"{diff.Hours}小时前" :
               $"{diff.Days}天前";
    }

