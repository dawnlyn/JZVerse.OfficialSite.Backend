@page "/gateway/routes"
@inject IGatewayApiClient GatewayClient
@inject IMessageService MessageService

<PageTitle>路由管理 - 微华夏</PageTitle>

<div class="route-manager-page">
    @* 页面标题区 *@
    <div class="page-header-section">
        <div class="header-title">
            <h1>路由管理</h1>
            <p class="subtitle">管理 API 网关路由规则，控制流量转发策略</p>
        </div>
        <div class="header-actions">
            <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="@AddRoute">
                添加路由
            </Button>
            <Button Icon="@IconType.Outline.Reload" Loading="@_loading" OnClick="@LoadDataAsync">
                刷新
            </Button>
        </div>
    </div>

    @* 统计卡片 *@
    <div class="stats-cards">
        <div class="stat-card">
            <span class="value">@_routes.Count</span>
            <span class="label">路由总数</span>
        </div>
        <div class="stat-card">
            <span class="value">@_routes.Count(r => r.Enabled)</span>
            <span class="label">已启用</span>
        </div>
        <div class="stat-card">
            <span class="value">@_routes.Count(r => !r.Enabled)</span>
            <span class="label">已禁用</span>
        </div>
        <div class="stat-card">
            <span class="value">@_routes.SelectMany(r => r.Methods).Distinct().Count()</span>
            <span class="label">HTTP 方法</span>
        </div>
    </div>

    @* 路由列表 *@
    <Card Class="route-table-card">
        <Table TItem="RouteInfo"
               DataSource="@_routes"
               Loading="@_loading"
               Size="TableSize.Middle"
               RowClassName="@GetRowClass">
            <PropertyColumn Property="c => c.Name" Title="路由名称" Width="180">
                <div class="route-name">
                    <span class="name">@context.Name</span>
                    @if (context.Priority > 100)
                    {
                        <Tag Color="orange" Size="small">高优</Tag>
                    }
                </div>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Path" Title="匹配路径">
                <code class="route-path">@context.Path</code>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Methods" Title="HTTP 方法" Width="180">
                <Space Size="SpaceSize.Small" Wrap>
                    @foreach (var method in context.Methods.Take(4))
                    {
                        <Tag Color="@GetMethodColor(method)" Size="small">@method</Tag>
                    }
                    @if (context.Methods.Count > 4)
                    {
                        <Tag Size="small">+@(context.Methods.Count - 4)</Tag>
                    }
                </Space>
            </PropertyColumn>
            <PropertyColumn Property="c => c.TargetService" Title="目标服务" Width="150">
                <span class="target-service">
                    <Icon Type="@IconType.Outline.Cluster" />
                    @context.TargetService
                </span>
            </PropertyColumn>
            <PropertyColumn Property="c => c.TargetPath" Title="目标路径">
                <code class="target-path">@context.TargetPath</code>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Enabled" Title="状态" Width="100">
                <Switch Checked="@context.Enabled" 
                        CheckedChildren="启用" 
                        UnCheckedChildren="禁用"
                        OnChange="@((v) => ToggleRoute(context, v))" />
            </PropertyColumn>
            <ActionColumn Title="操作" Width="150">
                <Space Size="SpaceSize.Small">
                    <Tooltip Title="编辑">
                        <Button Type="@ButtonType.Text" 
                                Icon="@IconType.Outline.Edit" 
                                OnClick="() => EditRoute(context)" />
                    </Tooltip>
                    <Tooltip Title="复制">
                        <Button Type="@ButtonType.Text" 
                                Icon="@IconType.Outline.Copy" 
                                OnClick="() => CopyRoute(context)" />
                    </Tooltip>
                    <Tooltip Title="删除">
                        <Popconfirm Title="确定要删除此路由吗？" 
                                    OkText="确定" 
                                    CancelText="取消" 
                                    OnConfirm="() => DeleteRoute(context.Id)">
                            <Button Type="@ButtonType.Text" 
                                    Danger 
                                    Icon="@IconType.Outline.Delete" />
                        </Popconfirm>
                    </Tooltip>
                </Space>
            </ActionColumn>
        </Table>
    </Card>
</div>

@* 路由编辑模态框 *@
<Modal Title="@(_isEditing ? "编辑路由" : "添加路由")"
       Visible="@_editModalVisible"
       OnOk="@SaveRoute"
       OnCancel="@(() => _editModalVisible = false)"
       ConfirmLoading="@_saving"
       Width="700"
       Class="route-modal">
    @if (_editingRoute != null)
    {
        <Form Model="@_editingRoute" Layout="@FormLayout.Vertical">
            <Row Gutter="16">
                <Col Span="12">
                    <FormItem Label="路由名称" Required>
                        <Input @bind-Value="@_editingRoute.Name" 
                               Placeholder="请输入路由名称" />
                    </FormItem>
                </Col>
                <Col Span="12">
                    <FormItem Label="优先级">
                        <AntDesign.InputNumber @bind-Value="@_editingRoute.Priority" 
                                               Min="0" 
                                               Max="1000"
                                               Style="width: 100%;" />
                    </FormItem>
                </Col>
            </Row>
            <FormItem Label="匹配路径" Required>
                <Input @bind-Value="@_editingRoute.Path" 
                       Placeholder="例如：/api/users/**">
                    <Prefix><Icon Type="@IconType.Outline.Gateway" /></Prefix>
                </Input>
            </FormItem>
            <FormItem Label="HTTP 方法" Required>
                <CheckboxGroup @bind-Value="@_selectedMethods" 
                               Options="@_methodOptions" />
            </FormItem>
            <Row Gutter="16">
                <Col Span="12">
                    <FormItem Label="目标服务" Required>
                        <Input @bind-Value="@_editingRoute.TargetService" 
                               Placeholder="请输入目标服务名称">
                            <Prefix><Icon Type="@IconType.Outline.Cluster" /></Prefix>
                        </Input>
                    </FormItem>
                </Col>
                <Col Span="12">
                    <FormItem Label="目标路径">
                        <Input @bind-Value="@_editingRoute.TargetPath" 
                               Placeholder="请输入目标路径" />
                    </FormItem>
                </Col>
            </Row>
            <Row Gutter="16">
                <Col Span="12">
                    <FormItem Label="负载均衡策略">
                        <Select @bind-Value="@_editingRoute.LoadBalancer">
                            <SelectOption Value="@("RoundRobin")">轮询 (RoundRobin)</SelectOption>
                            <SelectOption Value="@("Random")">随机 (Random)</SelectOption>
                            <SelectOption Value="@("WeightedRoundRobin")">加权轮询</SelectOption>
                            <SelectOption Value="@("LeastConnections")">最少连接</SelectOption>
                            <SelectOption Value="@("IpHash")">IP 哈希</SelectOption>
                        </Select>
                    </FormItem>
                </Col>
                <Col Span="12">
                    <FormItem Label="超时时间(秒)">
                        <AntDesign.InputNumber @bind-Value="@_editingRoute.TimeoutSeconds" 
                                               Min="1" 
                                               Max="300"
                                               Style="width: 100%;" />
                    </FormItem>
                </Col>
            </Row>
            <FormItem Label="启用状态">
                <Switch @bind-Checked="@_editingRoute.Enabled"
                        CheckedChildren="启用"
                        UnCheckedChildren="禁用" />
            </FormItem>
            <FormItem Label="高级设置" Class="advanced-section">
                <Collapse>
                    <Panel Header="重试策略" Key="1">
                        <FormItem Label="重试次数">
                            <AntDesign.InputNumber @bind-Value="@_editingRoute.RetryCount" 
                                                   Min="0" 
                                                   Max="10"
                                                   Style="width: 100%;" />
                        </FormItem>
                        <FormItem Label="重试间隔(ms)">
                            <AntDesign.InputNumber @bind-Value="@_editingRoute.RetryIntervalMs" 
                                                   Min="100" 
                                                   Max="10000"
                                                   Step="100"
                                                   Style="width: 100%;" />
                        </FormItem>
                    </Panel>
                    <Panel Header="熔断配置" Key="2">
                        <FormItem Label="错误率阈值(%)">
                            <AntDesign.InputNumber @bind-Value="@_editingRoute.CircuitBreakerThreshold" 
                                                   Min="0" 
                                                   Max="100"
                                                   Style="width: 100%;" />
                        </FormItem>
                        <FormItem Label="熔断时长(秒)">
                            <AntDesign.InputNumber @bind-Value="@_editingRoute.CircuitBreakerDuration" 
                                                   Min="10" 
                                                   Max="300"
                                                   Style="width: 100%;" />
                        </FormItem>
                    </Panel>
                </Collapse>
            </FormItem>
        </Form>
    }
</Modal>

<style>
    .route-manager-page {
        padding-bottom: 24px;
    }

    /* ===== 页面标题区 ===== */
    .page-header-section {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .header-title h1 {
        font-size: 24px;
        font-weight: 600;
        color: #040608;
        margin: 0 0 8px 0;
    }

    .header-title .subtitle {
        font-size: 14px;
        color: #76747C;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    /* ===== 统计卡片 ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    @@media (max-width: 992px) {
        .stats-cards {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .stat-card {
        background: #FFFFFF;
        border-radius: 12px;
        border: 1px solid #ECECEC;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .stat-card .value {
        font-size: 28px;
        font-weight: 600;
        color: #040608;
    }

    .stat-card .label {
        font-size: 13px;
        color: #76747C;
    }

    /* ===== 路由表格 ===== */
    .route-table-card {
        border-radius: 16px;
    }

    .route-table-card :deep(.ant-card-body) {
        padding: 0;
    }

    .route-table-card :deep(.ant-table) {
        border-radius: 0;
    }

    .route-name {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .route-name .name {
        font-weight: 500;
    }

    .route-path,
    .target-path {
        font-family: monospace;
        font-size: 13px;
        color: #43475C;
        background: #F9FAFB;
        padding: 4px 8px;
        border-radius: 4px;
    }

    .target-service {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #43475C;
    }

    .target-service :deep(.anticon) {
        color: #0A13F0;
    }

    /* ===== 弹窗样式 ===== */
    .route-modal :deep(.ant-modal-header) {
        border-bottom: 1px solid #ECECEC;
        padding: 20px 24px;
    }

    .route-modal :deep(.ant-modal-title) {
        font-size: 18px;
        font-weight: 600;
        color: #040608;
    }

    .route-modal :deep(.ant-modal-body) {
        padding: 24px;
    }

    .advanced-section :deep(.ant-collapse) {
        background: #F9FAFB;
        border-radius: 8px;
    }

    .advanced-section :deep(.ant-collapse-header) {
        font-weight: 500;
    }
</style>

@code {
    private List<RouteInfo> _routes = new();
    private bool _loading = false;
    private bool _editModalVisible = false;
    private bool _saving = false;
    private bool _isEditing = false;
    private RouteInfo? _editingRoute;
    private string[] _selectedMethods = Array.Empty<string>();

    private readonly CheckboxOption<string>[] _methodOptions = new[]
    {
        new CheckboxOption<string> { Value = "GET", Label = "GET" },
        new CheckboxOption<string> { Value = "POST", Label = "POST" },
        new CheckboxOption<string> { Value = "PUT", Label = "PUT" },
        new CheckboxOption<string> { Value = "DELETE", Label = "DELETE" },
        new CheckboxOption<string> { Value = "PATCH", Label = "PATCH" },
        new CheckboxOption<string> { Value = "HEAD", Label = "HEAD" },
        new CheckboxOption<string> { Value = "OPTIONS", Label = "OPTIONS" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _routes = await GatewayClient.GetRoutesAsync();
        }
        catch
        {
            // 模拟数据
            _routes = new List<RouteInfo>
            {
                new() { Id = "1", Name = "用户服务路由", Path = "/api/users/**", Methods = new() { "GET", "POST", "PUT", "DELETE" }, TargetService = "user-service", TargetPath = "/users", Enabled = true, Priority = 100, LoadBalancer = "RoundRobin", TimeoutSeconds = 30, RetryCount = 3, RetryIntervalMs = 1000 },
                new() { Id = "2", Name = "订单服务路由", Path = "/api/orders/**", Methods = new() { "GET", "POST", "PUT" }, TargetService = "order-service", TargetPath = "/orders", Enabled = true, Priority = 100, LoadBalancer = "RoundRobin", TimeoutSeconds = 30 },
                new() { Id = "3", Name = "支付服务路由", Path = "/api/payments/**", Methods = new() { "POST" }, TargetService = "payment-service", TargetPath = "/payments", Enabled = true, Priority = 200, LoadBalancer = "LeastConnections", TimeoutSeconds = 60 },
                new() { Id = "4", Name = "库存服务路由", Path = "/api/inventory/**", Methods = new() { "GET", "PUT" }, TargetService = "inventory-service", TargetPath = "/inventory", Enabled = false, Priority = 100, LoadBalancer = "RoundRobin", TimeoutSeconds = 30 },
                new() { Id = "5", Name = "搜索服务路由", Path = "/api/search/**", Methods = new() { "GET" }, TargetService = "search-service", TargetPath = "/search", Enabled = true, Priority = 50, LoadBalancer = "Random", TimeoutSeconds = 10 }
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private void AddRoute()
    {
        _isEditing = false;
        _editingRoute = new RouteInfo
        {
            Id = Guid.NewGuid().ToString(),
            LoadBalancer = "RoundRobin",
            TimeoutSeconds = 30,
            Enabled = true,
            Priority = 100,
            RetryCount = 3,
            RetryIntervalMs = 1000,
            CircuitBreakerThreshold = 50,
            CircuitBreakerDuration = 30
        };
        _selectedMethods = new[] { "GET", "POST" };
        _editModalVisible = true;
    }

    private void EditRoute(RouteInfo route)
    {
        _isEditing = true;
        _editingRoute = new RouteInfo
        {
            Id = route.Id,
            Name = route.Name,
            Path = route.Path,
            Methods = new List<string>(route.Methods),
            TargetService = route.TargetService,
            TargetPath = route.TargetPath,
            Enabled = route.Enabled,
            Priority = route.Priority,
            LoadBalancer = route.LoadBalancer,
            TimeoutSeconds = route.TimeoutSeconds,
            RetryCount = route.RetryCount,
            RetryIntervalMs = route.RetryIntervalMs,
            CircuitBreakerThreshold = route.CircuitBreakerThreshold,
            CircuitBreakerDuration = route.CircuitBreakerDuration
        };
        _selectedMethods = route.Methods.ToArray();
        _editModalVisible = true;
    }

    private void CopyRoute(RouteInfo route)
    {
        _isEditing = false;
        _editingRoute = new RouteInfo
        {
            Id = Guid.NewGuid().ToString(),
            Name = $"{route.Name}_副本",
            Path = route.Path,
            Methods = new List<string>(route.Methods),
            TargetService = route.TargetService,
            TargetPath = route.TargetPath,
            Enabled = false,
            Priority = route.Priority,
            LoadBalancer = route.LoadBalancer,
            TimeoutSeconds = route.TimeoutSeconds,
            RetryCount = route.RetryCount,
            RetryIntervalMs = route.RetryIntervalMs,
            CircuitBreakerThreshold = route.CircuitBreakerThreshold,
            CircuitBreakerDuration = route.CircuitBreakerDuration
        };
        _selectedMethods = route.Methods.ToArray();
        _editModalVisible = true;
    }

    private async Task SaveRoute()
    {
        if (_editingRoute == null) return;

        _editingRoute.Methods = _selectedMethods.ToList();

        _saving = true;
        try
        {
            await GatewayClient.UpsertRouteAsync(_editingRoute);
            await MessageService.Success(_isEditing ? "路由已更新" : "路由已创建");
            _editModalVisible = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await MessageService.Error($"保存失败: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteRoute(string routeId)
    {
        try
        {
            await GatewayClient.DeleteRouteAsync(routeId);
            await MessageService.Success("路由已删除");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await MessageService.Error($"删除失败: {ex.Message}");
        }
    }

    private async Task ToggleRoute(RouteInfo route, bool enabled)
    {
        route.Enabled = enabled;
        try
        {
            await GatewayClient.UpsertRouteAsync(route);
            await MessageService.Success(enabled ? "路由已启用" : "路由已禁用");
        }
        catch (Exception ex)
        {
            await MessageService.Error($"操作失败: {ex.Message}");
            route.Enabled = !enabled;
        }
    }

    private static string GetMethodColor(string method) =>
        method.ToUpperInvariant() switch
        {
            "GET" => "green",
            "POST" => "blue",
            "PUT" => "orange",
            "DELETE" => "red",
            "PATCH" => "purple",
            "HEAD" => "cyan",
            "OPTIONS" => "default",
            _ => "default"
        };

    private static string GetRowClass(RouteInfo route) =>
        route.Enabled ? "" : "disabled-row";
}
