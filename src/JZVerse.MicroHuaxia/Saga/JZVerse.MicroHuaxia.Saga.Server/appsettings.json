{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JZVerse.MicroHuaxia": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "saga-server",
    "ServiceVersion": "1.0.0",
    "Console": {
      "Enabled": true,
      "EnableColors": true,
      "MaxPayloadLength": 2048,
      "SlowCallThresholdMs": 500
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "Format": "Text",
      "MaxFileSizeMB": 50,
      "RetainDays": 30,
      "MaxTotalSizeMB": 1024
    },
    "OpenTelemetry": {
      "Enabled": true,
      "Endpoint": "http://localhost:17011",
      "Protocol": "Grpc"
    }
  },
  "Saga": {
    "Server": {
      "ServiceName": "saga-server",
      "Storage": "Memory",
      "CommunicationMode": "Http",
      "EnableTimeoutDetection": true,
      "EnableRecovery": true,
      "TimeoutSeconds": 300,
      "RecoveryIntervalSeconds": 60,
      "MaxConcurrentSagas": 1000
    }
  },
  "ServiceDiscovery": {
    "Client": {
      "ServerUrls": [ "http://localhost:5100" ],
      "Service": {
        "ServiceName": "saga-server",
        "Host": "localhost",
        "Port": 5104,
        "Scheme": "http",
        "Version": "1.0.0",
        "Tags": [ "saga" ],
        "Weight": 100,
        "AutoRegister": true,
        "AutoDeregister": true
      },
      "Heartbeat": {
        "Enabled": true,
        "IntervalSeconds": 10
      },
      "HealthCheck": {
        "Enabled": true,
        "Endpoint": "/health",
        "IntervalSeconds": 10
      }
    }
  },
  "ConfigCenter": {
    "Client": {
      "ServerUrls": [ "http://localhost:5101" ],
      "ApplicationId": "saga-server",
      "EnvironmentId": "development",
      "Namespaces": [ "saga.server" ],
      "NotificationMode": "Polling",
      "PollingIntervalSeconds": 30,
      "EnableLocalCache": true,
      "LocalCachePath": "./config-cache"
    }
  }
}
