{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JZVerse.MicroHuaxia.Security": "Debug"
    }
  },
  "AllowedHosts": "*",
  "SecurityServer": {
    "NodeId": "security-001",
    "ClusterId": "security-cluster",
    "ListenAddress": "0.0.0.0",
    "ListenPort": 8443,
    "Tls": {
      "Enabled": true,
      "CertificatePath": "",
      "PrivateKeyPath": "",
      "ClientCaPath": ""
    },
    "Storage": {
      "Type": "InMemory",
      "ConnectionString": ""
    },
    "ConfigCenter": {
      "Enabled": false,
      "Address": "http://localhost:8500",
      "Namespace": "security",
      "Token": ""
    },
    "ServiceDiscovery": {
      "Enabled": false,
      "Address": "http://localhost:8600",
      "RegisterName": "security-platform"
    }
  }
}
