{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JZVerse.MicroHuaxia": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "MessageQueueHost",
    "ServiceVersion": "1.0.0",
    "Console": {
      "Enabled": true,
      "EnableColors": true,
      "MaxPayloadLength": 2048,
      "SlowCallThresholdMs": 500
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "Format": "Text",
      "MaxFileSizeMB": 50,
      "RetainDays": 30,
      "MaxTotalSizeMB": 1024
    },
    "OpenTelemetry": {
      "Enabled": true,
      "Endpoint": "http://localhost:17011",
      "Protocol": "Grpc"
    }
  },
  "MessageQueue": {
    "Host": "0.0.0.0",
    "Port": 9527,
    "StorageType": "Memory",
    "DataDirectory": "./data/messagequeue",
    "MaxConnections": 10000,
    "HeartbeatTimeout": 60,
    "MessageRetentionHours": 168,
    "DefaultPartitions": 4,
    "EnableTracing": false,
    "EnableCompression": false
  },
  "ServiceDiscovery": {
    "Client": {
      "ServerUrls": [ "http://localhost:5100" ],
      "Service": {
        "ServiceName": "message-queue-host",
        "Host": "localhost",
        "Port": 5103,
        "Scheme": "http",
        "Version": "1.0.0",
        "Tags": [ "message-queue" ],
        "Weight": 100,
        "AutoRegister": true,
        "AutoDeregister": true
      },
      "Heartbeat": {
        "Enabled": true,
        "IntervalSeconds": 10
      },
      "HealthCheck": {
        "Enabled": true,
        "Endpoint": "/health",
        "IntervalSeconds": 10
      }
    }
  },
  "ConfigCenter": {
    "Client": {
      "ServerUrls": [ "http://localhost:5101" ],
      "ApplicationId": "message-queue-host",
      "EnvironmentId": "development",
      "Namespaces": [ "messagequeue.broker" ],
      "NotificationMode": "Polling",
      "PollingIntervalSeconds": 30,
      "EnableLocalCache": true,
      "LocalCachePath": "./config-cache"
    }
  }
}
