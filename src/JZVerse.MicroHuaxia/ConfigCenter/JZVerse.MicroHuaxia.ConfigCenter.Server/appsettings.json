{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JZVerse.MicroHuaxia": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "ConfigCenterServer",
    "ServiceVersion": "1.0.0",
    "Console": {
      "Enabled": true,
      "EnableColors": true,
      "MaxPayloadLength": 2048,
      "SlowCallThresholdMs": 500
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "Format": "Text",
      "MaxFileSizeMB": 50,
      "RetainDays": 30,
      "MaxTotalSizeMB": 1024
    },
    "OpenTelemetry": {
      "Enabled": true,
      "Endpoint": "http://localhost:17011",
      "Protocol": "Grpc"
    }
  },
  "ConfigCenter": {
    "Server": {
      "ServiceName": "config-center-server",
      "EnableCache": true,
      "CacheTtlSeconds": 60,
      "EnablePersistence": true,
      "PersistencePath": "./data/config",
      "SnapshotIntervalMinutes": 5,
      "LongPollingTimeoutSeconds": 30,
      "EnableWebSocket": true
    }
  },
  "ServiceDiscovery": {
    "Client": {
      "ServerUrls": [ "http://localhost:5100" ],
      "Service": {
        "ServiceName": "config-center-server",
        "Host": "localhost",
        "Port": 5101,
        "Scheme": "http",
        "Version": "1.0.0",
        "Tags": [ "config-center" ],
        "Weight": 100,
        "AutoRegister": true,
        "AutoDeregister": true
      },
      "Heartbeat": {
        "Enabled": true,
        "IntervalSeconds": 10
      },
      "HealthCheck": {
        "Enabled": true,
        "Endpoint": "/health",
        "IntervalSeconds": 10
      }
    }
  }
}
