{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JZVerse.MicroHuaxia": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "ServiceName": "api-gateway",
    "ListenPorts": {
      "Http": 5000,
      "Https": 5001,
      "Management": 5002,
      "Grpc": 5003
    },
    "ServiceDiscovery": {
      "Enabled": true,
      "UseLocal": true
    },
    "ConfigCenter": {
      "Enabled": true,
      "UseLocal": true,
      "ApplicationId": "gateway",
      "EnvironmentId": "development",
      "RoutesNamespace": "gateway.routes",
      "AuthenticationNamespace": "gateway.authentication"
    },
    "DynamicRouting": {
      "Enabled": true,
      "RefreshIntervalSeconds": 30,
      "Source": "ConfigCenter"
    },
    "DefaultTimeout": "00:00:30",
    "MaxConcurrentRequests": 1000,
    "EnableMetrics": true,
    "EnableAuditLog": true
  },
  "ServiceDiscovery": {
    "Server": {
      "ServiceName": "service-discovery-server",
      "HealthCheckIntervalSeconds": 10,
      "HealthCheckTimeoutSeconds": 5,
      "HeartbeatTimeoutSeconds": 30,
      "FailureThreshold": 3,
      "LoadBalancer": "RoundRobin",
      "EnableCache": true,
      "CacheTtlSeconds": 60
    }
  },
  "ConfigCenter": {
    "Server": {
      "ServiceName": "config-center-server",
      "EnableCache": true,
      "CacheTtlSeconds": 60,
      "EnablePersistence": false
    }
  }
}
