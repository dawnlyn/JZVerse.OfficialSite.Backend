{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "JZVerse.MicroHuaxia": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "GatewayServer",
    "ServiceVersion": "1.0.0",
    "Console": {
      "Enabled": true,
      "EnableColors": true,
      "MaxPayloadLength": 2048,
      "SlowCallThresholdMs": 500
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "Format": "Text",
      "MaxFileSizeMB": 50,
      "RetainDays": 30,
      "MaxTotalSizeMB": 1024
    },
    "OpenTelemetry": {
      "Enabled": true,
      "Endpoint": "http://localhost:17011",
      "Protocol": "Grpc"
    }
  },
  "Gateway": {
    "ServiceName": "api-gateway",
    "ListenPorts": {
      "Http": 5102,
      "Https": 5201,
      "Management": 5202,
      "Grpc": 5203
    },
    "ServiceDiscovery": {
      "Enabled": true,
      "UseLocal": false
    },
    "ConfigCenter": {
      "Enabled": true,
      "UseLocal": false
    },
    "DynamicRouting": {
      "Enabled": true,
      "RefreshIntervalSeconds": 30,
      "Source": "ConfigCenter"
    },
    "DefaultTimeout": "00:00:30",
    "MaxConcurrentRequests": 1000,
    "EnableMetrics": true,
    "EnableAuditLog": true
  },
  "ServiceDiscovery": {
    "Client": {
      "ServerUrls": ["http://localhost:5100"],
      "Service": {
        "ServiceName": "api-gateway",
        "Host": "localhost",
        "Port": 5102,
        "Scheme": "http",
        "Version": "1.0.0",
        "Tags": ["gateway"],
        "Weight": 100,
        "AutoRegister": true,
        "AutoDeregister": true
      },
      "Heartbeat": {
        "Enabled": true,
        "IntervalSeconds": 10
      },
      "HealthCheck": {
        "Enabled": true,
        "Endpoint": "/health"
      }
    }
  },
  "ConfigCenter": {
    "Client": {
      "ServerUrls": ["http://localhost:5101"],
      "ApplicationId": "api-gateway",
      "EnvironmentId": "development",
      "Namespaces": ["gateway.routes", "gateway.authentication"],
      "NotificationMode": "Polling",
      "PollingIntervalSeconds": 30,
      "EnableLocalCache": true,
      "LocalCachePath": "./config-cache"
    }
  }
}
